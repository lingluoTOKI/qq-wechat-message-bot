function fmt(value){return value?new Date(Number(value)*1000).toLocaleString('zh-CN',{timeZone:'Asia/Shanghai',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}):'时间未记录';}
function wechatLabel(v){return ({listening:'监听中',waiting_queue:'等待队列',waiting_service:'等待服务',connecting:'连接中',stale:'状态过期',not_started:'未启动',disabled:'未启用'})[v]||v||'未知';}
function dated(value){let match=String(value.deadline||'').match(/(20\d{2})[-/年](\d{1,2})[-/月](\d{1,2})日?\s*(\d{1,2})[:：](\d{2})/);if(match){const [,y,m,d,h,min]=match;return Date.parse(`${y}-${m.padStart(2,'0')}-${d.padStart(2,'0')}T${h.padStart(2,'0')}:${min}:00+08:00`);}const rel=String(value.deadline||'').match(/(今天|今日|明天|明日)\s*(\d{1,2})[:：](\d{2})/);if(rel&&value.source_time&&!value.time_approximate){const date=new Date(Number(value.source_time)*1000+8*3600000);if(rel[1].startsWith('明'))date.setUTCDate(date.getUTCDate()+1);const iso=date.toISOString().slice(0,10);return Date.parse(`${iso}T${rel[2].padStart(2,'0')}:${rel[3]}:00+08:00`);}return null;}
function loadData(data){ops=data;if(!prefsDirty)prefs=data.preferences||{};groups=(data.groups||[]).map(g=>({...g,time:g.last_seen?fmt(g.last_seen)+' 收到消息':'最近时间未记录'}));const now=Date.now(),day=new Date(now+28800000).toISOString().slice(0,10);tasks=(data.matters||[]).filter(v=>v.kind==='action').map(v=>{const due=dated(v);return {...v,title:v.summary,group:v.source,time:fmt(v.source_time),note:v.time_approximate?'这里只保留事项摘要，时间是会话参考时间，请在原会话核实。':'这里只保留事项摘要，请回到原会话查看完整通知。',deadline:due?fmt(due/1000):v.deadline&&v.deadline!=='未明确'?v.deadline:'期限待确认',bucket:due?(due<now?'overdue':new Date(due+28800000).toISOString().slice(0,10)===day?'today':'later'):'unknown',due};}).sort((a,b)=>({overdue:0,today:1,later:2,unknown:3}[a.bucket]-{overdue:0,today:1,later:2,unknown:3}[b.bucket])||(a.due||Infinity)-(b.due||Infinity)||Number(b.urgent)-Number(a.urgent));refs=(data.matters||[]).filter(v=>v.kind==='reference').map(v=>({...v,title:v.summary,text:v.action||'仅供参考，请结合原会话核实。',group:v.source,star:v.starred,read:v.done,low:groups.find(g=>g.platform===v.platform&&g.conversation===v.conversation)?.level==='低关注',type:/未核实|未经|转述|猜测/.test(v.summary)?'未经证实':'参考信息'}));}
async function refreshData(redraw=true){if(loading)return;loading=true;try{const results=await Promise.allSettled([api('operations'),api('status')]);if(results[0].status==='fulfilled')loadData(results[0].value);if(results[1].status==='fulfilled')connection=results[1].value;const failed=results.find(r=>r.status==='rejected');localError=failed?failed.reason.message:'';if(!failed)lastSync=new Date();if(redraw)render();}finally{loading=false;}}
async function refreshHistory(){try{const value=await api('history');historyRecords=value.saved_reports||historyRecords;if(!selectedHistory)historyValue=value;if(page==='history'&&!$('summaryDialog').open)render();}catch(e){if(page==='history')toast(e.message);}}
async function mutate(body){await api('operations',body);await refreshData(false);}
async function refreshCloud(){try{const r=await fetch('/api/overview',{cache:'no-store',signal:AbortSignal.timeout(10000)});if(r.status===401){cloudError='云端管理需要登录';cloud=null;return;}const d=await r.json();if(!r.ok||!d.ok)throw Error('云端状态暂时无法读取');cloud=d;cloudError='';}catch{cloudError='无法连接云端管理服务；不影响本机个人提醒';}finally{if(['overview','status'].includes(page))render();}}
function statusCards(){const entries=[['本机个人 QQ',localError?'状态未更新':connection?(connection.qq_connected?'已连接':'未连接'):'正在检查','负责个人 QQ 消息接收和私聊发送。'],['本机微信',localError?'状态未更新':wechatLabel(connection?.wechat_state),'电脑微信需要保持登录，休眠后停止读取。'],['云端大肥鱼',cloudError|| (cloud?cloud.services?.astrbot?.running?'运行中':'未运行':'尚未查询'),'云端群机器人独立运行，不代表本机 QQ 状态。']];return entries.map(([name,state,desc])=>`<article class="status-card">${icon(name.startsWith('云端')?'overview':'groups')}<h3>${name}</h3><div class="status-value"><i class="dot ${/未|失败|无法/.test(state)?'off':''}"></i>${esc(state)}</div><p>${desc}</p></article>`).join('');}
function renderStatus(){return title('STATUS / 各服务独立显示','运行状态','分析、连接和通知异常分别处理。',button('启动本地提醒','start','primary'))+'<div class="status-cards">'+statusCards()+'</div><div class="spacer"></div><div class="panel"><div class="panel-head"><h3>需要处理的情况</h3><a class="button text" href="http://127.0.0.1:5100/" target="_blank" rel="noopener">QQ 登录管理 ↗</a></div><div class="panel-pad">'+(localError?`<div class="info-box notice-box">${esc(localError)}。请检查本地程序是否运行。</div>`:'')+(connection?.budget_reason?`<div class="info-box notice-box">${esc(connection.budget_reason)}</div>`:'')+(ops.failures||[]).map(v=>`<div class="setting-row"><span>分析失败 · ${esc(v.source)}<small>${esc(fmt(v.at))}</small></span>${button('重新分析','retry_analysis','',`data-id="${esc(v.id)}"`)}</div>`).join('')+(ops.uncertain||[]).map(v=>`<div class="setting-row"><span>私聊送达未确认<small>先检查接收人的QQ，避免重复发送。</small></span><div>${button('已收到','dismiss_delivery','text',`data-id="${esc(v.id)}"`)}${button('确认补发','retry_delivery','',`data-id="${esc(v.id)}"`)}</div>`).join('')+`<p class="subtitle">等待分析 ${Number(connection?.pending_messages||0)} 条 · QQ等待补处理 ${Number(ops.qq_waiting_recovery||0)} 条</p>${ops.usage_unverified?.requests?`<p class="subtitle">${Number(ops.usage_unverified.requests)} 次请求用量待核实，并非已确认消耗。可到设置核对平台余额。</p>`:''}</div></div>`;}
function renderOverview(){return title('SERVICES / 机器人管理','服务概览','本机与云端分别显示。',button('检查云端','cloud-refresh'))+'<div class="status-cards">'+statusCards()+'</div><div class="spacer"></div><div class="panel"><div class="panel-head"><h3>云端服务器与机器人</h3><a class="button text" href="/legacy" target="_blank" rel="noopener">完整管理 ↗</a></div><div class="panel-pad">'+(cloud?`<dl class="detail-data"><dt>主机</dt><dd>${esc(cloud.server?.hostname||'—')}</dd><dt>系统</dt><dd>${esc(cloud.server?.os||'—')}</dd><dt>CPU</dt><dd>${esc(cloud.server?.cpuPercent??'—')}%</dd><dt>内存</dt><dd>${esc(cloud.server?.mem?.percent??'—')}%</dd><dt>AstrBot</dt><dd>${esc(cloud.bots?.astrbot?.version||'版本未提供')}</dd></dl>`:`<p class="muted">${esc(cloudError||'正在读取云端状态…')}</p><form id="cloudLogin"><label class="field">云端管理密码<input type="password" id="cloudPassword" autocomplete="current-password" required></label><button class="button primary" type="submit">登录云端管理</button></form>`)+ '</div></div>';}
function renderEntry(){return title('CONSOLES / 管理入口','控制台入口','入口明确区分云端机器人与本机个人帐号。')+'<div class="status-cards">'+[['AstrBot','云端群机器人，管理插件与模型。','/entry/astrbot'],['本机 SnowLuma','个人 QQ 登录与连接管理。','http://127.0.0.1:5100/'],['完整服务管理','保留原有云端服务操作及详细指标。','/legacy']].map(([name,desc,url])=>`<article class="status-card">${icon('entry')}<h3>${name}</h3><p>${desc}</p><div class="spacer"></div><a class="button" href="${url}" target="_blank" rel="noopener">打开 ↗</a></article>`).join('')+'</div>';}
function renderLogs(){return title('LOGS / 仅排错时查看','运行日志','只在进入本页或点击刷新时读取，不自动刷屏。',button('拉取日志','logs-refresh'))+`<div class="toolbar"><select class="inline-select" id="logSource" aria-label="日志来源"><option value="local" ${logSource==='local'?'selected':''}>本机 SnowLuma</option><option value="astrbot" ${logSource==='astrbot'?'selected':''}>云端 AstrBot</option><option value="snowluma" ${logSource==='snowluma'?'selected':''}>云端 SnowLuma</option></select><span class="muted">日志仅用于排错</span></div><pre class="log-lines">${esc(logText)}</pre>`;}
async function readLogs(){try{if(logSource==='local'){const d=await api('snowluma-log');logText=d.text||d.log||(Array.isArray(d.lines)?d.lines.join('\n'):d.message||'暂无日志');}else{const r=await fetch('/api/logs?service='+logSource+'&lines=100',{signal:AbortSignal.timeout(10000)});if(!r.ok)throw Error('云端管理未登录或连接失败');const d=await r.json();logText=d.text||d.log||(Array.isArray(d.lines)?d.lines.join('\n'):'暂无日志');}}catch(e){logText=e.message;}if(page==='logs')render();}
function go(next){if(prefsDirty&&page==='settings'&&next!==page&&!confirm('个人偏好尚未保存，离开将放弃修改。继续？'))return;prefsDirty=false;page=next;source='all';query='';showDone=false;localStorage.setItem('fish-workbench-page',page);render();$('sidebar').classList.remove('open');$('scrim').hidden=true;window.scrollTo(0,0);if(next==='history')refreshHistory();if(next==='overview')refreshCloud();if(next==='logs')readLogs();}
function detail(id){const t=tasks.find(t=>t.id===id);if(!t)return;$('detailContent').innerHTML=`<div class="dialog-head"><span class="tag">事项详情</span><button class="icon-button close-dialog" aria-label="关闭详情">${icon('close')}</button></div><h2 id="detailTitle" class="detail-title">${esc(t.title)}</h2><dl class="detail-data"><dt>来源</dt><dd>${t.platform==='qq'?'QQ':'微信'} · ${esc(t.group)}</dd><dt>${t.time_approximate?'参考时间':'原消息时间'}</dt><dd>${esc(t.time)}</dd><dt>期限</dt><dd>${esc(t.deadline)}</dd><dt>状态</dt><dd>${t.done?'已完成':t.snoozed?'稍后处理':'未完成'}</dd></dl><div class="detail-content"><h3>需要做什么</h3><p>${esc(t.action||'请查看原会话确认。')}</p></div><div class="info-box">${esc(t.note)}</div><p class="subtitle">稍后处理仅改变展示位置，不自动推送定时提醒。</p><div class="dialog-actions">${button(t.snoozed?'恢复待办':'稍后处理','snooze','',`data-id="${esc(t.id)}"`)}${button(t.done?'恢复未完成':'标记完成','complete','primary',`data-id="${esc(t.id)}"`)}</div>`;$('detailDialog').showModal();}
function summary(ids){if(historyValue.state==='running'){go('history');toast('当前已有任务正在运行，请等待或停止。');return;}const chosen=ids||[...selectedGroups];$('summaryGroups').innerHTML=groups.map(g=>`<label><input type="checkbox" name="summaryGroup" value="${esc(g.id)}" ${chosen.includes(g.id)?'checked':''}>${platformBadge(g.platform)} ${esc(g.label)}</label>`).join('')||'<p class="muted">暂无已识别群，请保持监听并在收到群消息后刷新。</p>';$('summaryDialog').showModal();}
function download(name,text){const url=URL.createObjectURL(new Blob([text],{type:'text/plain;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
async function savePrefs(){const f=$('preferences');if(!f.reportValidity())return;const d=new FormData(f),p={};for(const key of ['name','aliases','school','className','role','goal','target','description','uncertain','timing','digest','recipient'])p[key]=String(d.get(key)||'');p.interests=d.getAll('interest');p.noise=d.has('noise');p.merge=d.has('merge');await api('operations',{action:'preferences',id:'settings',preferences:p});prefsDirty=false;await refreshData();toast('已保存，下次分析与通知使用新设置。');}
async function groupUpdate(g,patch){await mutate({action:'group_settings',id:g.id,level:g.level,delivery:g.delivery,...patch});}
async function startLocal(){const result=await api('start',{});toast(result.message||'正在启动…');for(let i=0;i<45;i++){await new Promise(r=>setTimeout(r,2000));const v=await api('start');if(v.state==='error')throw Error(v.message);if(v.state==='ready'){await refreshData();toast(v.message);return;}}toast('启动仍未完成，请在运行状态页检查。');}
function showQuota(){const s=connection||{};$('detailContent').innerHTML=`<div class="dialog-head"><h2 id="detailTitle">赠送额度与校准</h2><button class="icon-button close-dialog" aria-label="关闭">${icon('close')}</button></div><dl class="detail-data"><dt>当前模型</dt><dd>${esc(s.model||'未知')}</dd><dt>估算剩余</dt><dd>${Number(s.token_remaining||0).toLocaleString()} token</dd><dt>接口用量</dt><dd>${Number(s.token_measured||0).toLocaleString()}</dd><dt>待核实</dt><dd>${Number(s.token_unverified||0).toLocaleString()}，不是已确认消耗</dd></dl><p class="subtitle">本地估算不等于平台余额。填写智谱实际剩余额度进行校准；分析中暂不可校准。</p><a class="button text" href="https://bigmodel.cn/finance-center/resource-package/package-mgmt" target="_blank" rel="noopener">查看智谱资源包 ↗</a><label class="field">平台剩余 token<input id="quotaRemaining" type="number" min="0" max="15000000" step="1"></label>${button('确认校准','calibrate','primary')}`;$('detailDialog').showModal();}
document.addEventListener('click',async e=>{const close=e.target.closest('.close-dialog');if(close){close.closest('dialog').close();return;}const nav=e.target.closest('[data-page]');if(nav){go(nav.dataset.page);return;}const filter=e.target.closest('[data-source]');if(filter){source=filter.dataset.source;render();return;}const b=e.target.closest('[data-action]');if(!b||b.disabled)return;const a=b.dataset.action,id=b.dataset.id;b.disabled=true;try{
if(a==='detail')detail(id);else if(a==='goto-reference')go('reference');else if(a==='goto-status')go('status');else if(['complete','snooze','read','star'].includes(a)){const v=(a==='read'||a==='star'?refs:tasks).find(v=>v.id===id);const field=a==='snooze'?'snoozed':a==='star'?'starred':'done',before=!!v[field],action=a==='snooze'?'snooze':a==='star'?'star':'done';const payload={action,id,[action==='done'?'done':'enabled']:!before};await mutate(payload);if($('detailDialog').open)$('detailDialog').close();render();toast('已保存。',async()=>{await mutate({...payload,[action==='done'?'done':'enabled']:before});render();});}
else if(a==='reduce'){const v=refs.find(v=>v.id===id),g=groups.find(g=>g.platform===v.platform&&g.conversation===v.conversation);if(!g)throw Error('此条来源不是已识别群聊');const old=g.level;await groupUpdate(g,{level:'低关注'});render();toast('已降低该群参考内容优先级。',async()=>{await groupUpdate(g,{level:old});render();});}
else if(a==='summary'||a==='summary-selected')summary();else if(a==='summary-one')summary([id]);else if(a==='clear-selected'){selectedGroups.clear();render();}else if(a==='batch-focus'){const chosen=groups.filter(g=>selectedGroups.has(g.id)),before=chosen.map(g=>({...g}));for(const g of chosen)await groupUpdate(g,{level:'重点关注'});render();toast('已保存所选群。',async()=>{for(const g of before)await groupUpdate(g,{});render();});}
else if(a==='cancel-history'){await api('history',{action:'cancel'});await refreshHistory();}else if(a==='open-report'){selectedHistory=id;historyValue=await api('history?report='+encodeURIComponent(id));render();}else if(a==='latest-report'){selectedHistory=null;await refreshHistory();}
else if(a==='export-history')download('群历史摘要.txt','群历史摘要 '+fmt(historyValue.started_at)+'\n'+(historyValue.scope||'')+'\n'+(historyValue.items||[]).map(i=>`【${i.platform==='qq'?'QQ':'微信'} · ${i.source}】\n${i.summary}\n${i.deadline||''}\n${i.action||''}`).join('\n\n')+'\n'+(historyValue.warnings||[]).join('\n'));
else if(a==='save-settings')await savePrefs();else if(a==='export-matters')download('个人事项.txt',(ops.matters||[]).map(v=>`【${v.source}】${v.done?'已处理':'未处理'}\n${v.summary}\n${v.deadline||''}\n${v.action||''}`).join('\n\n'));
else if(a==='demo-manage')go('status');else if(a==='quota')showQuota();else if(a==='start')await startLocal();else if(a==='calibrate'){const input=$('quotaRemaining');if(input.value===''||!input.reportValidity())throw Error('请填写有效的平台剩余额度');await api('calibrate',{remaining:Number(input.value)});$('detailDialog').close();await refreshData();toast('余额已校准。');}
else if(a==='cloud-refresh')await refreshCloud();else if(a==='logs-refresh')await readLogs();else if(['retry_analysis','dismiss_delivery','retry_delivery'].includes(a)){if(a==='retry_delivery'&&!confirm('确认接收人的QQ未收到？补发可能产生重复通知。'))return;await mutate({action:a,id,confirmed:true});render();toast('操作已保存。');}
}catch(error){toast(error.message);}finally{if(b.isConnected)b.disabled=false;}});
document.addEventListener('change',async e=>{const n=e.target;try{if(n.id==='showDone'){showDone=n.checked;render();}else if(n.dataset.groupSelect){n.checked?selectedGroups.add(n.dataset.groupSelect):selectedGroups.delete(n.dataset.groupSelect);render();}else if(n.id==='selectAll'){groups.filter(matches).forEach(g=>n.checked?selectedGroups.add(g.id):selectedGroups.delete(g.id));render();}else if(n.dataset.groupLevel||n.dataset.groupDelivery){const g=groups.find(g=>g.id===(n.dataset.groupLevel||n.dataset.groupDelivery)),field=n.dataset.groupLevel?'level':'delivery',before=g[field];if(n.value==='暂停分析'&&!confirm('暂停后可能漏掉该群通知。明确选择的历史总结仍可运行。继续？')){n.value=before;return;}n.disabled=true;try{await groupUpdate(g,{[field]:n.value});toast('群聊设置已保存。',async()=>{await groupUpdate(g,{[field]:before});render();});}catch(error){n.value=before;throw error;}finally{n.disabled=false;}}else if(n.id==='logSource'){logSource=n.value;await readLogs();}}catch(error){toast(error.message);}});
document.addEventListener('input',e=>{if(e.target.closest('#preferences'))prefsDirty=true;if(e.target.id==='search'){const pos=e.target.selectionStart;query=e.target.value;render();$('search').focus();$('search').setSelectionRange(pos,pos);}});
$('summaryForm').onsubmit=async e=>{e.preventDefault();const ids=[...document.querySelectorAll('[name=summaryGroup]:checked')].map(n=>n.value);if(!ids.length||ids.length>10){toast('请选择1至10个群聊。');return;}const b=e.submitter;b.disabled=true;try{await api('history',{days:Number($('summaryRange').value),source:'all',groups:ids});$('summaryDialog').close();selectedHistory=null;go('history');}catch(error){toast(error.message);}finally{b.disabled=false;}};
document.addEventListener('submit',async e=>{if(e.target.id==='preferences'){e.preventDefault();try{await savePrefs();}catch(error){toast(error.message);}}if(e.target.id==='cloudLogin'){e.preventDefault();const password=$('cloudPassword').value;try{const r=await fetch('/api/login',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({password}),signal:AbortSignal.timeout(10000)}),v=await r.json();if(!r.ok||!v.ok)throw Error(v.message||'登录失败');$('cloudPassword').value='';await refreshCloud();}catch(error){toast(error.message);}}});
$('refresh').onclick=async()=>{if(prefsDirty){toast('设置尚未保存，请先保存或离开设置页。');return;}if(page==='history')await refreshHistory();else if(page==='logs')await readLogs();else if(page==='overview')await refreshCloud();else await refreshData();};$('menuToggle').onclick=()=>{$('sidebar').classList.add('open');$('scrim').hidden=false;};$('scrim').onclick=()=>{$('sidebar').classList.remove('open');$('scrim').hidden=true;};document.addEventListener('keydown',e=>{if(e.key==='Escape'){$('sidebar').classList.remove('open');$('scrim').hidden=true;}});
render();refreshData();if(page==='history')refreshHistory();if(page==='overview')refreshCloud();setInterval(()=>{if(document.hidden)return;if(page==='history'&&!selectedHistory)refreshHistory();},4000);setInterval(()=>{if(document.hidden||loading)return;refreshData(false).then(()=>{if(!prefsDirty&&!$('detailDialog').open&&!$('summaryDialog').open&&!document.activeElement?.matches('input,select,textarea')&&page!=='history'&&page!=='logs'&&page!=='overview')render();});},30000);
